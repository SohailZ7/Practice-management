generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// role: ADMIN | PROVIDER | STAFF    theme: system | light | dark
model User {
  id        String         @id @default(cuid())
  email     String         @unique
  name      String
  role      String         @default("STAFF")
  active    Boolean        @default(true)
  theme     String         @default("system")
  createdAt DateTime       @default(now())
  access    ModuleAccess[]
}

// module: schedule | tasks | employees   level: none | view | edit
model ModuleAccess {
  id     String @id @default(cuid())
  userId String
  module String
  level  String @default("none")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
}

model Employee {
  id     String   @id @default(cuid())
  name   String
  title  String   @default("")
  email  String?  @unique
  phone  String   @default("")
  active Boolean  @default(true)
  tasks  Task[]
  provider Provider?
  recurring RecurringTask[]
}

// Providers shown on the schedule. employeeId null = external provider.
model Provider {
  id           String   @id @default(cuid())
  name         String   @unique
  contact      String   @default("")
  npi          String   @default("")
  zoomLink     String   @default("")
  zoomPassword String   @default("")
  hours        String   @default("")
  notes        String   @default("")
  employeeId   String?  @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  entries      ScheduleEntry[]
}

model TrackDef {
  id        String @id @default(cuid())
  name      String @unique
  startTime String @default("")
  endTime   String @default("")
  sortOrder Int    @default(0)
}

model EntryType {
  id   String @id @default(cuid())
  name String @unique
}

// section: PSYCH_EVAL | TRACK    date: YYYY-MM-DD
model ScheduleEntry {
  id           String    @id @default(cuid())
  date         String
  section      String
  timeLabel    String    @default("")
  trackName    String    @default("")
  typeName     String    @default("")
  clientInfo   String    @default("")
  providerId   String?
  providerName String    @default("")
  absent       Boolean   @default(false)
  canceled     Boolean   @default(false)
  completed    Boolean   @default(false)
  missed       Boolean   @default(false)
  dedupeKey    String    @default("")
  importLogId  String?
  createdAt    DateTime  @default(now())
  provider     Provider? @relation(fields: [providerId], references: [id])

  @@index([date])
  @@index([dedupeKey])
}

model Category {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int    @default(0)
  tasks     Task[]
}

// dueDate: YYYY-MM-DD
model Task {
  id              String         @id @default(cuid())
  title           String
  categoryId      String?
  assigneeId      String?
  dueDate         String?
  completed       Boolean        @default(false)
  completedAt     DateTime?
  inToday         Boolean        @default(false)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignee        Employee?      @relation(fields: [assigneeId], references: [id])
  links           TaskLink[]
  recurringId     String?
  occurrenceDate  String?
  recurring       RecurringTask? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@unique([recurringId, occurrenceDate])
}

// type: webex | pr | doc | markdown | link
model TaskLink {
  id     String @id @default(cuid())
  taskId String
  url    String
  label  String
  type   String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  detail     String   @default("")
  createdAt  DateTime @default(now())
}

model ImportLog {
  id         String   @id @default(cuid())
  fileName   String
  sheet      String
  userEmail  String
  rowsFound  Int
  created    Int
  duplicates Int
  skipped    Int
  createdAt  DateTime @default(now())
}

// Parsed upload waiting for the user to confirm.
model ImportDraft {
  id        String   @id @default(cuid())
  userEmail String
  fileName  String
  sheet     String
  payload   String
  createdAt DateTime @default(now())
}

// ---- Billing (modeled on bandbc-billing-app) ----

model Program {
  id        String      @id @default(cuid())
  name      String      @unique
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  encounters Encounter[]
}

// MRN is optional; an admin can add it later. mergedIntoId keeps merged records instead of erasing them.
model BillingPatient {
  id           String      @id @default(cuid())
  mrn          String?     @unique
  lastName     String
  firstName    String
  createdById  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  mergedIntoId String?
  encounters   Encounter[]

  @@index([lastName, firstName])
}

// encounterDate: YYYY-MM-DD. icd10Codes: in order, first = primary.
model Encounter {
  id               String         @id @default(cuid())
  patientId        String
  encounterDate    String
  programId        String
  icd10Codes       String[]
  chargeCode       String         @default("")
  note             String         @default("")
  getixEntered     Boolean        @default(false)
  getixEnteredAt   DateTime?
  getixEnteredById String?
  createdById      String
  createdAt        DateTime       @default(now())
  updatedById      String?
  updatedAt        DateTime?
  deletedAt        DateTime?
  deletedById      String?
  patient          BillingPatient @relation(fields: [patientId], references: [id])
  program          Program        @relation(fields: [programId], references: [id])

  @@index([patientId, encounterDate])
  @@index([createdById])
  @@index([encounterDate])
}

// Append-only (through the app): the previous version of a record, saved before every change.
model BillingHistory {
  id          String   @id @default(cuid())
  entity      String
  entityId    String
  action      String
  snapshot    Json
  changedById String
  changedAt   DateTime @default(now())

  @@index([entity, entityId, changedAt])
}

// ---- Ledger: business cash in / cash out (modeled on the practice's ledger spreadsheet) ----

model LedgerCategory {
  id        String        @id @default(cuid())
  name      String        @unique
  sortOrder Int           @default(0)
  entries   LedgerEntry[]
}

model LedgerMethod {
  id        String        @id @default(cuid())
  name      String        @unique
  sortOrder Int           @default(0)
  entries   LedgerEntry[]
}

// "Transaction By" choices.
model LedgerParty {
  id        String        @id @default(cuid())
  name      String        @unique
  sortOrder Int           @default(0)
  entries   LedgerEntry[]
}

// Amounts are whole cents so totals are exact. date: YYYY-MM-DD.
model LedgerEntry {
  id          String          @id @default(cuid())
  date        String
  cashIn      Int             @default(0)
  cashOut     Int             @default(0)
  partyId     String?
  categoryId  String?
  methodId    String?
  comments    String          @default("")
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  party       LedgerParty?    @relation(fields: [partyId], references: [id], onDelete: SetNull)
  category    LedgerCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  method      LedgerMethod?   @relation(fields: [methodId], references: [id], onDelete: SetNull)

  @@index([date])
}

// A task that repeats. weekday: 0 = Monday .. 6 = Sunday. dayOfMonth: 1..31 (short months use the last day).
// An instance (a normal Task, due on the occurrence date) is created in the assignee's queue when it comes due.
model RecurringTask {
  id             String    @id @default(cuid())
  title          String
  assigneeId     String?
  frequency      String
  weekday        Int?
  dayOfMonth     Int?
  startDate      String
  endDate        String?
  active         Boolean   @default(true)
  lastOccurrence String?
  createdById    String
  createdAt      DateTime  @default(now())
  assignee       Employee? @relation(fields: [assigneeId], references: [id])
  tasks          Task[]
}
