{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Practice Recorder",
  "version": "1.0.7",
  "identifier": "org.practice.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Brain and Behavior Center",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://practice-mgmt-802176721153.us-east4.run.app https://practice-mgmt-321509350517.us-east4.run.app http://localhost:3000"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyNjBENTQyNDMzNEUwNzUKUldSMTREUkRRdFZnb3VqbUxPbkc2Rlc0K3g5ZXJjVjB6dEg2YjR5elNVMkZOc2NSL0Y2TXp2YjEK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "resources/models/": "models/"
    }
  }
}