{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Practice Notes",
  "version": "0.0.1",
  "identifier": "org.practice.notes.spike",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Practice Notes", "width": 1180, "height": 780, "minWidth": 900, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "14.0" }
  }
}
