# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://practice:practice@localhost:5432/practice"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth client (see README for setup)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Security / PHI (see docs/hipaa-readiness.md) ---
# REQUIRED in production (the server refuses to start without it). Field-level encryption key: base64 of 32 random bytes.
#   Generate with: npm run phi:generate-key    (or: openssl rand -base64 32)
# In production keep it in Secret Manager / KMS, not in a file. Losing it makes the encrypted fields unreadable: back it up separately from the database.
PHI_ENCRYPTION_KEY=""
# Id stamped on every value this key encrypts. Change it (and keep the old key below) when you rotate.
PHI_ENCRYPTION_KEY_ID="k1"
# Old keys kept so existing values stay readable after a rotation: "k1:base64,k0:base64". Then run: npm run db:encrypt-phi -- --database <name> --rekey
PHI_ENCRYPTION_PREVIOUS_KEYS=""

# Automatic logoff. Defaults shown.
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS=12

# How many proxies sit in front of the app and append to X-Forwarded-For (Cloud Run alone: 1). Used by the rate limiter.
TRUSTED_PROXY_HOPS=1

# --- Desktop App (requirements v19, section 5.7) ---
# OAuth client id (type "Desktop app") the Mac app signs in with. The Desktop API refuses sign-in without it.
GOOGLE_DESKTOP_CLIENT_ID=
# The matching secret. For a "Desktop app" client Google does not treat this as confidential; PKCE and the allowlist
# are what protect the sign-in. Leave both empty to use pairing tokens instead (Settings, "Connect a recorder").
GOOGLE_DESKTOP_CLIENT_SECRET=

# Optional. Signs the Desktop App's access tokens. When empty, a key derived from NEXTAUTH_SECRET is used.
DESKTOP_TOKEN_SECRET=

# --- Notes module ---
# Where the note-writing model runs, and which model to use.
# Production: Gemini on Vertex AI in our GCP project (Google BAA). Uses the Cloud Run service account; needs
# the Vertex AI API enabled and roles/aiplatform.user on that account.
NOTES_VERTEX_PROJECT=
NOTES_VERTEX_LOCATION=global
# Local testing only: output of `gcloud auth print-access-token`.
NOTES_VERTEX_TOKEN=
# Development only: a local Ollama server. Leave NOTES_MODEL_URL blank in production.
NOTES_MODEL_URL=
# Model name for whichever backend is used (default gemini-3.5-flash on Vertex, qwen2.5:14b-instruct on Ollama).
NOTES_MODEL=
NOTES_MODEL_KEY=
# Pre-fills the provider box on the paste screen.
NOTES_DEFAULT_PROVIDER=
