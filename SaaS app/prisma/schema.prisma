generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// role: ADMIN | PROVIDER | STAFF    theme: system | light | dark
model User {
  id                      String              @id @default(cuid())
  email                   String              @unique
  name                    String
  role                    String              @default("STAFF")
  active                  Boolean             @default(true)
  theme                   String              @default("system")
  // Desktop recorder may show full patient names (default: initials only). Set by an admin per user.
  showFullNames           Boolean             @default(false)
  // May approve, request changes on, or reject Feedback items that are On staging. Set by an admin per user.
  feedbackApprover        Boolean             @default(false)
  // Final approver of Ledger expenses (Sohail). Set by an admin per user; existing users default to false.
  ledgerApprover          Boolean             @default(false)
  // Last Desktop version this person's recorder reported, and the newest version whose update banner they dismissed.
  desktopVersion          String?
  desktopSeenAt           DateTime?
  desktopDismissedVersion String?
  createdAt               DateTime            @default(now())
  lastLoginAt             DateTime?
  access                  ModuleAccess[]
  taskViewers             TaskViewer[]
  desktopSessions         DesktopSession[]
  apiTokens               ApiToken[]
  feedback                FeedbackItem[]
  diagnostics             DesktopDiagnostic[]
}

// module: schedule | tasks | employees   level: none | view | edit
model ModuleAccess {
  id     String @id @default(cuid())
  userId String
  module String
  level  String @default("none")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
}

model Employee {
  id        String          @id @default(cuid())
  name      String
  title     String          @default("")
  email     String?         @unique
  phone     String          @default("")
  active    Boolean         @default(true)
  // Shown as a tab under Tasks. The Admin adds and removes tabs; removing keeps the employee and their history.
  taskTab   Boolean         @default(true)
  tasks     Task[]
  provider  Provider?
  recurring RecurringTask[]
  viewedBy  TaskViewer[]
}

// Providers shown on the schedule. employeeId null = external provider.
model Provider {
  id           String          @id @default(cuid())
  name         String          @unique
  contact      String          @default("")
  npi          String          @default("")
  zoomLink     String          @default("")
  zoomPassword String          @default("")
  hours        String          @default("")
  notes        String          @default("")
  employeeId   String?         @unique
  employee     Employee?       @relation(fields: [employeeId], references: [id])
  // Tracked for volume and revenue only: never flows to billing, documents, invoices or timesheets.
  trackingOnly Boolean         @default(false)
  unmatched    UnmatchedAppointment[]
  visits       Visit[]
  timeOff      ProviderTimeOff[]
}

// Days a provider is unavailable (vacation, sick, conference, limitation). Additive; dates are YYYY-MM-DD text like Visit.visitDate.
// Informational: it warns when scheduling, it never blocks or edits existing visits.
model ProviderTimeOff {
  id             String   @id @default(cuid())
  providerId     String
  provider       Provider @relation(fields: [providerId], references: [id])
  startDate      String
  endDate        String // inclusive; equals startDate for a single day
  kind           String   @default("time_off") // time_off | sick | conference | limitation
  note           String   @default("")
  createdByEmail String
  createdAt      DateTime @default(now())

  @@index([providerId, startDate])
}

model TrackDef {
  id        String @id @default(cuid())
  name      String @unique
  startTime String @default("")
  endTime   String @default("")
  sortOrder Int    @default(0)
}

model EntryType {
  id   String @id @default(cuid())
  name String @unique
}

// section: PSYCH_EVAL | TRACK    date: YYYY-MM-DD

model Category {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int    @default(0)
  tasks     Task[]
}

// dueDate: YYYY-MM-DD
model Task {
  id             String         @id @default(cuid())
  title          String
  notes          String         @default("")
  categoryId     String?
  assigneeId     String?
  dueDate        String?
  expiresAt      String?
  completed      Boolean        @default(false)
  // not_started | in_progress | done. `completed` stays the source of truth for Done (old rows and the sync read it);
  // this column only tells not_started from in_progress while a task is open. See taskStatus() in taskTypes.ts.
  status         String         @default("not_started")
  // high | normal | low. Additive (default normal). Auto sort orders by priority, then due date; drag order is the manual override.
  priority       String         @default("normal")
  completedAt    DateTime?
  inToday        Boolean        @default(false)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  category       Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignee       Employee?      @relation(fields: [assigneeId], references: [id])
  links          TaskLink[]
  updates        TaskUpdate[]
  recurringId    String?
  occurrenceDate String?
  // Set when the task is mirrored from another app (the Sohail Todo App): source name and that app's id.
  externalSource String?
  externalId     String?
  // Staging only (docs/promote-to-production.md): isTest items are never promoted; promotedAt/promotedProdId record a promotion.
  isTest         Boolean        @default(false)
  promotedAt     DateTime?
  promotedProdId String?
  recurring      RecurringTask? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@unique([recurringId, occurrenceDate])
  @@unique([externalSource, externalId])
}

// type: webex | pr | doc | markdown | link
model TaskLink {
  id     String @id @default(cuid())
  taskId String
  url    String
  label  String
  type   String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  detail     String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorEmail])
}

model ImportLog {
  id         String   @id @default(cuid())
  fileName   String
  sheet      String
  userEmail  String
  rowsFound  Int
  created    Int
  duplicates Int
  skipped    Int
  createdAt  DateTime @default(now())
}

// Parsed upload waiting for the user to confirm.
model ImportDraft {
  id        String   @id @default(cuid())
  userEmail String
  fileName  String
  sheet     String
  payload   String
  createdAt DateTime @default(now())
}

// ---- Billing (modeled on bandbc-billing-app) ----

model Program {
  id         String      @id @default(cuid())
  name       String      @unique
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  encounters Encounter[]
}

// Editable reference lists (Administration > Lists): visit types, charge codes, documentation types, order types.
// One new table, additive only. Rows store the list value as text elsewhere, so renaming an item never rewrites old days.
model RefItem {
  id          String   @id @default(cuid())
  kind        String // visit_type | charge_code | doc_type | order_type
  value       String
  docType     String? // charge_code only: the documentation type this code goes with
  nonBillable Boolean  @default(false) // charge_code only
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([kind, value])
  @@index([kind, active, sortOrder])
}

// MRN is optional; an admin can add it later. mergedIntoId keeps merged records instead of erasing them.
model Patient {
  id              String           @id @default(cuid())
  mrn             String?          @unique
  lastName        String
  firstName       String
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  mergedIntoId    String?
  // Chart basics (Web 1.60). All nullable and additive. mrn above is B&B's own MRN; ffxMrn is the Fairfax hospital MRN.
  ffxMrn          String?
  dob             String? // YYYY-MM-DD
  sex             String?
  insurance       String?
  admissions      PatientAdmission[]
  encounters      Encounter[]
  consents        PatientConsent[]
  Visit           Visit[]

  @@index([lastName, firstName])
  // Renamed in code only (docs/patient-model-proposal.md, Phase 1): the table keeps its name, so no SQL runs.
  @@map("BillingPatient")
}

// Consent for AI-assisted visit documentation (requirements v19, CON-1). History is kept; at most one row per patient
// is active (enforced in code, inside a transaction). consentDate: YYYY-MM-DD in the practice time zone.
// A recorded visit (requirements v17 / change request 17). The audio never reaches the server: the recorder
// transcribes on the Mac and pushes only the text. visitDate: YYYY-MM-DD in the practice time zone.
model Visit {
  id                    String          @id @default(cuid())
  patientId             String
  visitDate             String
  appointmentType       String          @default("")
  program               String          @default("")
  apptTime              String          @default("")
  providerName          String          @default("")
  // What happened to the visit: scheduled | seen | no_show | cancelled | note_signed (see src/lib/notes/visitStatus.ts).
  status                String          @default("scheduled")
  transcript            String          @default("")
  transcriptAt          DateTime?
  // Display-only speaker names for the transcript, e.g. {"Speaker 1":"Provider"}. Nullable and additive; the stored transcript text is never rewritten.
  speakerLabels         Json?
  createdByEmail        String
  createdAt             DateTime        @default(now())
  // Unification, Release A (docs/release-a-runbook.md): the Visit becomes the one appointment record. Every column below is
  // nullable and additive; nothing reads them yet. Filled by scripts/unify-backfill.ts, only where still null.
  legacyScheduleEntryId String? // the ScheduleEntry this Visit mirrors or was inserted from (trace only, not a FK)
  backfilledAt          DateTime? // set ONLY on Visits the migration inserted; list readers skip them until Release B
  startTime             String? // HH:MM (24h) parsed from the schedule time text; exact time, or start of a range
  endTime               String? // HH:MM (24h), only for a range
  timeLabel             String? // the original schedule time text
  section               String? // PSYCH_EVAL | TRACK
  trackName             String?
  providerId            String?
  encounterId           String? // filled by Seen-to-Encounter (a later phase), not by Release A
  scheduleNotes         String?
  discharged            Boolean?
  overdueBasis          String?
  patient               Patient         @relation(fields: [patientId], references: [id])
  documents             VisitDocument[]
  notes                 VisitNote[]
  changeRequests        VisitChangeRequest[]
  checklist             VisitChecklistItem[]
  provider              Provider?       @relation(fields: [providerId], references: [id], onDelete: SetNull)
  encounter             Encounter?      @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  @@index([visitDate])
  @@index([patientId, visitDate])
  @@index([legacyScheduleEntryId])
  @@index([providerId])
  @@index([encounterId])
}

// One generated document, stored as Markdown. Every save keeps the previous text as a version, so an edit can be
// traced and nothing a provider wrote is lost.
model VisitDocument {
  id            String                 @id @default(cuid())
  visitId       String
  kind          String
  label         String
  markdown      String
  draft         Boolean                @default(true)
  attention     String                 @default("")
  // Template-based documents (progress_note | psych_eval | admit_order | discharge_order). Null on documents written
  // before templates existed; those read as a single "content" field whose version 1 is the stored markdown.
  docType       String?
  templateId    String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  visit         Visit                  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  versions      VisitDocumentVersion[]
  fieldVersions DocumentVersion[]

  @@index([visitId])
}

model VisitDocumentVersion {
  id           String        @id @default(cuid())
  documentId   String
  markdown     String
  savedByEmail String
  savedAt      DateTime      @default(now())
  document     VisitDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// One saved state of a template-based document: field values by name. Version 1 is source "model" (what the model
// produced); every later save is source "edit". Rows are never updated, so the original output can always be compared
// with the clinician's final text. (documentId, version) is unique, which is what makes concurrent saves safe.
model DocumentVersion {
  id           String        @id @default(cuid())
  documentId   String
  version      Int
  source       String
  values       Json
  authorUserId String?
  createdAt    DateTime      @default(now())
  document     VisitDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
}

model PatientConsent {
  id               String    @id @default(cuid())
  patientId        String
  consentDate      String
  note             String    @default("")
  active           Boolean   @default(true)
  confirmedByEmail String
  createdAt        DateTime  @default(now())
  withdrawnByEmail String?
  withdrawnAt      DateTime?
  patient          Patient   @relation(fields: [patientId], references: [id])

  @@index([patientId, active])
}

// One row per signed-in Mac (requirements v19, API-2, API-9). Only a hash of the refresh token is stored.
model DesktopSession {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  deviceLabel String    @default("")
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  // Version of the Mac app on this device, as it last reported (update check or diagnostics).
  appVersion  String?
  appSeenAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Admin-issued token for the Claude MCP server (docs/mcp-server.md). Acts as `userId`, limited to `scope`.
// Only the SHA-256 hash is stored; the token is shown once. scope: tasks
model ApiToken {
  id             String    @id @default(cuid())
  userId         String
  label          String    @default("")
  scope          String    @default("tasks")
  tokenHash      String    @unique
  createdByEmail String
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?
  expiresAt      DateTime
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// encounterDate: YYYY-MM-DD. icd10Codes: in order, first = primary.
model Encounter {
  id               String    @id @default(cuid())
  patientId        String
  encounterDate    String
  programId        String
  icd10Codes       String[]
  chargeCode       String    @default("")
  note             String    @default("")
  getixEntered     Boolean   @default(false)
  getixEnteredAt   DateTime?
  getixEnteredById String?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedById      String?
  updatedAt        DateTime?
  deletedAt        DateTime?
  deletedById      String?
  // Documentation check flow (Web 1.67): submitted > verified > entered in GetIX. All nullable, additive.
  submittedAt      DateTime?
  submittedById    String?
  verifiedAt       DateTime?
  verifiedById     String?
  // Incorrect Billing bucket: flagged by an admin, action needed until marked complete.
  incorrectAt         DateTime?
  incorrectById       String?
  incorrectNote       String    @default("")
  incorrectResolvedAt DateTime?
  patient          Patient   @relation(fields: [patientId], references: [id])
  program          Program   @relation(fields: [programId], references: [id])
  visits           Visit[]

  @@index([patientId, encounterDate])
  @@index([createdById])
  @@index([encounterDate])
}

// Append-only (through the app): the previous version of a record, saved before every change.
model BillingHistory {
  id          String   @id @default(cuid())
  entity      String
  entityId    String
  action      String
  snapshot    Json
  changedById String
  changedAt   DateTime @default(now())

  @@index([entity, entityId, changedAt])
}

// ---- Ledger: business cash in / cash out (modeled on the practice's ledger spreadsheet) ----

model LedgerCategory {
  id        String        @id @default(cuid())
  name      String        @unique
  sortOrder Int           @default(0)
  entries   LedgerEntry[]
}

model LedgerMethod {
  id        String        @id @default(cuid())
  name      String        @unique
  sortOrder Int           @default(0)
  entries   LedgerEntry[]
}

// "Transaction By" choices.
model LedgerParty {
  id        String        @id @default(cuid())
  name      String        @unique
  sortOrder Int           @default(0)
  entries   LedgerEntry[]
}

// Amounts are whole cents so totals are exact. date: YYYY-MM-DD.
model LedgerEntry {
  id          String          @id @default(cuid())
  date        String
  cashIn      Int             @default(0)
  cashOut     Int             @default(0)
  partyId     String?
  categoryId  String?
  methodId    String?
  comments    String          @default("")
  // pending | approved | rejected. Existing and cash-in rows are approved (default); every new expense (cash out) starts pending.
  // Approved entries are locked. Only a ledgerApprover can approve or reject.
  approvalStatus String       @default("approved")
  approvedById   String?
  approvedAt     DateTime?
  approvalNote   String       @default("")
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  party       LedgerParty?    @relation(fields: [partyId], references: [id], onDelete: SetNull)
  category    LedgerCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  method      LedgerMethod?   @relation(fields: [methodId], references: [id], onDelete: SetNull)

  timesheetPayment TimesheetPayment?

  @@index([date])
}

// A task that repeats. weekday: 0 = Monday .. 6 = Sunday. dayOfMonth: 1..31 (short months use the last day).
// An instance (a normal Task, due on the occurrence date) is created in the assignee's queue when it comes due.
model RecurringTask {
  id             String    @id @default(cuid())
  title          String
  assigneeId     String?
  frequency      String
  weekday        Int?
  dayOfMonth     Int?
  startDate      String
  endDate        String?
  active         Boolean   @default(true)
  lastOccurrence String?
  createdById    String
  createdAt      DateTime  @default(now())
  assignee       Employee? @relation(fields: [assigneeId], references: [id])
  tasks          Task[]
}

// Lets a user see (read-only) the tasks of another employee, in addition to their own.
// level: view (read-only) | edit
model TaskViewer {
  id         String   @id @default(cuid())
  userId     String
  employeeId String
  level      String   @default("view")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([userId, employeeId])
}

// Every change of a task's assignee. Ids and names only, never task text. Append-only in the database
// (prisma/sql/audit-append-only.sql). kind: assigned | created-for | tab-removed
model TaskMove {
  id        String   @id @default(cuid())
  taskId    String
  fromId    String?
  fromName  String
  toId      String?
  toName    String
  kind      String
  movedBy   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([taskId])
}

// Timesheets (Admin only for now). Hourly rate and charge are in cents. startMin/endMin are minutes after midnight.
// userId is unused today; a later release can link an employee to a login so they see only their own sheet.
model TimesheetEmployee {
  id               String             @id @default(cuid())
  name             String             @unique
  defaultRateCents Int                @default(2300)
  sortOrder        Int                @default(0)
  userId           String?
  createdAt        DateTime           @default(now())
  entries          TimesheetEntry[]
  payments         TimesheetPayment[]
}

model TimesheetEntry {
  id          String            @id @default(cuid())
  employeeId  String
  date        String
  startMin    Int
  endMin      Int
  rateCents   Int
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
  employee    TimesheetEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
}

// Feedback and bug reports from signed-in users. kind is FEEDBACK or BUG. Text only; never put patient information here.
model FeedbackItem {
  id              String            @id @default(cuid())
  kind            String
  title           String
  description     String            @default("")
  authorId        String
  source          String            @default("web")
  isTest          Boolean           @default(false)
  promotedAt      DateTime?
  promotedProdId  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  author          User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // Feedback-to-production workflow: new | triaged | building | on_staging | tested | released | rejected.
  // Older rows may still hold build_it | approved | needs_changes | shipped; the app reads them as the new states.
  status          String            @default("new")
  // Triage outcome: accepted | rejected | more_info (null = not triaged yet).
  triageOutcome   String?
  // Set by the owner when accepting at triage: ui_small | other. Only ui_small may auto-promote once Tested.
  scope           String?
  testNotes       String            @default("")
  ownerApprovedAt DateTime?
  /// Web release number (16 = "Web 1.16") this item was built in; production marks it Shipped when it runs that release.
  shippedRelease  Int?
  events          FeedbackEvent[]
  comments        FeedbackComment[]

  @@index([createdAt])
  @@index([status])
}

// One row per status/scope/test-notes change: who, when, from, to. No free text, so nothing PHI can land here.
model FeedbackEvent {
  id        String       @id @default(cuid())
  itemId    String
  actorName String
  actorKind String       @default("user")
  field     String       @default("status")
  fromValue String?
  toValue   String?
  createdAt DateTime     @default(now())
  item      FeedbackItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

// What an approver wants fixed (or the agent's reply). Text is checked for patient information before it is stored.
model FeedbackComment {
  id         String       @id @default(cuid())
  itemId     String
  authorName String
  authorKind String       @default("user")
  body       String
  createdAt  DateTime     @default(now())
  item       FeedbackItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

// Production side of "Promote to production": one row per staging item received, so a retry of the same sourceId
// returns the existing item instead of creating a duplicate. kind: task | feedback. targetId = the new Task/FeedbackItem id.
model PromotedItem {
  id        String   @id @default(cuid())
  kind      String
  sourceId  String
  targetId  String
  createdAt DateTime @default(now())

  @@unique([kind, sourceId])
}

// What has been paid to a timesheet employee. Each payment has a matching cash-out row in the Ledger (ledgerEntryId);
// edits and deletes here update that row, and the Ledger refuses to edit or delete it directly, so nothing is counted twice.
// methodId is a LedgerMethod id (no foreign key, so a removed method just shows blank). coversMonth is YYYY-MM or null.
model TimesheetPayment {
  id            String            @id @default(cuid())
  employeeId    String
  date          String
  amountCents   Int
  methodId      String?
  note          String            @default("")
  coversMonth   String?
  ledgerEntryId String?           @unique
  createdById   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  employee      TimesheetEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  ledgerEntry   LedgerEntry?      @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)

  @@index([employeeId, date])
}

// Mac recorder diagnostics: versions, kinds and codes only (src/lib/desktop/diagnostics.ts). Pruned after 30 days.
model DesktopDiagnostic {
  id          String   @id @default(cuid())
  userId      String?
  receivedAt  DateTime @default(now())
  appVersion  String
  commit      String   @default("")
  os          String
  arch        String
  environment String
  manual      Boolean  @default(false)
  events      Json
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([receivedAt])
  @@index([userId, receivedAt])
}

// A recording's transcript as the Desktop app uploads it, keyed by the Desktop's own UUID. It exists before (and
// without) any visit link, so an upload never fails because the visit is missing. `text` is encrypted at rest.
model RecordingInbox {
  id              String   @id
  seq             Int
  final           Boolean  @default(false)
  text            String   @default("")
  sha256          String
  durationSeconds Float    @default(0)
  recordedAt      DateTime
  visitId         String?
  createdByEmail  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([visitId])
  @@index([createdAt])
}

// Recording-consent confirmation: the checkbox a user ticked before a recording or a Generate. One row per
// confirmation (web or Desktop). `visitId` may be null when a Desktop upload arrives before it is linked to a
// visit; `recordingId` then ties it to the inbox upload and linking fills `visitId`. Additive; no patient data.
model RecordingConsent {
  id          String   @id @default(cuid())
  visitId     String?
  recordingId String?
  userId      String?
  userEmail   String
  given       Boolean
  textVersion String
  source      String   @default("web")
  givenAt     DateTime
  createdAt   DateTime @default(now())

  @@index([visitId, givenAt])
  @@index([recordingId])
}

// Unification, Release B2a: appointments that have no patient yet (imports, free-text adds). They are not Visits because a
// Visit needs a patient. Copied from ScheduleEntry by scripts/unify-copy-unmatched.ts (same id, same stored values, same
// encrypted clientInfo); ScheduleEntry is dropped in B2b. Linking a patient turns a row into a Visit and deletes it here.
model UnmatchedAppointment {
  id           String    @id @default(cuid())
  date         String
  section      String
  timeLabel    String    @default("")
  trackName    String    @default("")
  typeName     String    @default("")
  clientInfo   String    @default("")
  providerId   String?
  providerName String    @default("")
  absent       Boolean   @default(false)
  canceled     Boolean   @default(false)
  completed    Boolean   @default(false)
  missed       Boolean   @default(false)
  dedupeKey    String    @default("")
  importLogId  String?
  patientId    String?
  createdAt    DateTime  @default(now())
  provider     Provider? @relation(fields: [providerId], references: [id])

  @@index([date])
  @@index([dedupeKey])
}

// Soft-hide for pick-list values (program | appointment_type | provider). Additive. Hiding only removes the value from the
// pick lists for NEW visits; past visits keep their stored text and still edit and bill normally. Never deleted, restorable.
model HiddenOption {
  id            String   @id @default(cuid())
  kind          String
  value         String
  hiddenByEmail String
  hiddenAt      DateTime @default(now())

  @@unique([kind, value])
}

// A dated update posted on a task (separate from its notes). The assignee sees an "Update" badge until they open it (seenAt).
// Text is checked for patient information before it is stored and is never written to the audit log.
model TaskUpdate {
  id          String    @id @default(cuid())
  taskId      String
  authorEmail String
  authorName  String
  body        String
  createdAt   DateTime  @default(now())
  seenAt      DateTime?
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// One row per stay. A readmission is a NEW row on the SAME patient, so history is kept; at most one row is open
// (dischargeDate null) at a time, enforced in code. Dates are YYYY-MM-DD. Additive.
model PatientAdmission {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  admitDate      String
  dischargeDate  String?
  createdByEmail String
  createdAt      DateTime @default(now())

  @@index([patientId, admitDate])
}

// Comment-style notes on a visit: many per visit, author and time on each, optional resolved flag. kind: general | provider | admin.
// Additive. Note text is never written to the audit log.
model VisitNote {
  id              String    @id @default(cuid())
  visitId         String
  visit           Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  kind            String    @default("general")
  body            String
  authorEmail     String
  authorName      String
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedByEmail String?

  @@index([visitId, createdAt])
}

// Files uploaded in Billing (GetIX reports and other files). Small files only (5 MB each), kept in the database. Additive.
model BillingFile {
  id           String   @id @default(cuid())
  name         String
  mime         String   @default("application/octet-stream")
  size         Int
  data         Bytes
  note         String   @default("")
  uploadedByEmail String
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// A staff edit to an existing visit (time, program, type) waits here until an admin approves it. Additive.
model VisitChangeRequest {
  id           String    @id @default(cuid())
  visitId      String
  patch        Json
  requestedBy  String
  createdAt    DateTime  @default(now())
  status       String    @default("pending") // pending | approved | rejected
  decidedBy    String?
  decidedAt    DateTime?
  visit        Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([status])
}

// Per-visit Documentation / Orders checklist: each item is completed and, once completed, can be marked sent to FFX. Additive.
model VisitChecklistItem {
  id         String   @id @default(cuid())
  visitId    String
  kind       String // documentation | order
  label      String
  done       Boolean  @default(false)
  sentToFfx  Boolean  @default(false)
  updatedBy  String
  createdAt  DateTime @default(now())
  visit      Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, kind, label])
  @@index([visitId])
}
